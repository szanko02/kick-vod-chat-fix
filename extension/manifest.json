{
  "manifest_version": 2,
  "name": "__MSG_extensionName__",
  "version": "1.0.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "https://kick.com/*",
    "https://assets.kick.com/*"
  ],
  "background": {
    "scripts": ["replay-template.js", "rewrite.js", "background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_title": "__MSG_extensionName__",
    "default_popup": "popup.html",
    "default_icon": "icons/icon.svg"
  },
  "content_scripts": [
    {
      "matches": ["https://kick.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "kick-replay-chat-buffer@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
